# BikeDoc environment configuration.
# Copy to .env.local and fill in at most one key. Leave both keys empty to run
# in demo mode (sample rule-based diagnosis, no AI calls).

# OpenAI API key. If both keys are set, OpenAI is preferred.
# Default model: gpt-4o-mini
OPENAI_API_KEY=

# Anthropic API key. Used only when OPENAI_API_KEY is empty.
# Default model: claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Optional: override the model id for whichever provider is active
# (e.g. gpt-4o or claude-opus-5-5). Leave empty to use the default above.
BIKEDOC_MODEL=
